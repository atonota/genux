---
// The commands install the Ant Design and React versions pinned in the repository manifest;
// the GenUX adapters and styles come from Source and resources.
import manifest from '../../../package.json';
import { repositoryUrl } from '../data/repository';

const versions = manifest.devDependencies;
const packages = (['antd', 'react', 'react-dom'] as const)
  .map(name => `${name}@${versions[name]}`)
  .join(' ');
const managers = [
  ['npm', 'npm install'],
  ['yarn', 'yarn add'],
  ['pnpm', 'pnpm add'],
  ['bun', 'bun add'],
] as const;
---

<div class="docs-install" data-install>
  <h3 data-i18n="Install prerequisites">Install prerequisites</h3>
  <p data-i18n="Install the pinned Ant Design and React versions GenUX is built on, then use the adapters and styles listed under Source and resources.">
    Install the pinned Ant Design and React versions GenUX is built on, then use the adapters and
    styles listed under Source and resources.
  </p>
  {/* One command variant picker; without JS the four commands below stay readable. The
      supplied draft's shared command surface is retained, with one discoverable control. */}
  <div class="docs-install-command">
    <div class="docs-install-picker" data-install-picker hidden>
      <div class="docs-install-control" data-install-control>
        <label data-install-label data-i18n="Package manager">
          Package manager
        </label>
        <button type="button" class="docs-install-trigger" data-install-trigger>
          <span data-install-value>npm</span>
          <span class="docs-install-chevron" aria-hidden="true">
            ⌄
          </span>
        </button>
      </div>
      <div class="docs-install-positioner" data-install-positioner>
        <ul class="docs-install-options" data-install-options>
          {managers.map(([id]) => (
            <li class="docs-install-option" data-install-manager={id}>
              <span>{id}</span>
              <span class="docs-install-selected" aria-hidden="true" data-i18n="Selected">
                Selected
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    {managers.map(([id, command]) => <pre
      data-install-command={id}
    ><code>{`${command} ${packages}`}</code></pre>)}
  </div>
  <div class="docs-install-command">
    <pre><code>{`git clone ${repositoryUrl}.git`}</code></pre>
  </div>
</div>
