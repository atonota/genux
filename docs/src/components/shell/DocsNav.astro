---
import { catalogGroups } from '../../data/component-navigation';
import { foundationGroups, genuxPageHref } from '../../data/foundation-navigation';
import genux from '../../data/genux.json';
import { inputPaddingInline, inputSurfaceAliasVariables } from '../../data/input-surfaces';
import './nav.css';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
// The product guide keeps one canonical path under either hosting base.
const genuxHref = genuxPageHref(import.meta.env.BASE_URL);

/* Static GenUXInputFrame adapter: genux-input.css paints the search well from the shared
   field model and the md size profile (genuxSizeProfiles reads the same genux.json), while
   the native input stays the DocsLayout filter target without an island. It opts into the
   shared underlined variant, whose functional bottom edge identifies the field at rest. */
const searchSize = 'md';
const searchHeight = genux.decisions.buttons.size_variants.find(
  profile => profile.value === searchSize,
)?.height_px;
const searchFrameStyle: Record<string, string> = {
  ...inputSurfaceAliasVariables(),
  '--genux-input-padding-inline': `${inputPaddingInline[searchSize]}px`,
  ...(searchHeight != null ? { '--genux-input-height': `${searchHeight}px` } : {}),
};
---

<div class="navigation" id="navigation" data-nosnippet>
  <h2 class="navigation-title" id="docs-navigation-title">
    <span data-i18n="Component library">Component library</span>
  </h2>
  <nav aria-label="Documentation" data-i18n-aria-label="Documentation">
    <label class="nav-search">
      <span data-i18n="Find a component">Find a component</span>
      <span
        class="genux-input-frame"
        data-genux-input="text"
        data-size={searchSize}
        data-variant="underlined"
        style={searchFrameStyle}
      >
        <input
          type="search"
          id="component-search"
          class="genux-input-native"
          placeholder="Search"
          data-i18n-placeholder="Search"
          autocomplete="off"
        />
      </span>
    </label>
    <div class="nav-search-feedback">
      <p id="search-status" role="status" hidden>
        <span data-i18n="No results found.">No results found.</span>
      </p>
      <button
        type="button"
        class="nav-search-clear"
        data-docs-search-clear
        data-shell-i18n="Clear search"
        hidden
      >
        Clear search
      </button>
    </div>
    <div class="nav-scroll" data-docs-nav-scroll>
      {foundationGroups.map(group => (
        <section class="nav-group">
          <h2 data-i18n={group.label}>{group.label}</h2>
          <ul class="nav-foundations">
            {group.links.map(item => (
              <li>
                <a
                  href={item.slug === 'genux' ? genuxHref : item.href}
                  aria-current={slug === item.slug ? 'page' : undefined}
                >
                  <span data-i18n={item.label}>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {catalogGroups.map(group => (
        <section class="nav-group">
          <h2 data-i18n={group.label}>{group.label}</h2>
          <ul>
            {group.components.map(item => (
              <li data-component-link={item.title + ' ' + item.slug}>
                <a
                  href={'/components/' + item.slug + '/'}
                  aria-current={slug === item.slug ? 'page' : undefined}
                  data-i18n={item.title}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </nav>
</div>

<script>
  import { installDocsNavState } from './nav-state';

  installDocsNavState(document);
</script>
