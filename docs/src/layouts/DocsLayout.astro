---
import { docsThemeStyleText as themeStyleText } from '../theme';
import { docsBrandStyleText } from '../data/docs-brand';
import { docsTypographyStyleText } from '../data/typography';
import { docsAccessibilityStyleText } from '../data/accessibility';
import { selectionSizeStyleText } from '../data/selection-sizes';
import '../styles/docs.css';
import '../styles/genux-shadows.css';
import '../styles/components.css';
import '../styles/web.css';
import '../styles/size-profiles.css';
import '../styles/interaction-feedback.css';
import '../styles/docs-brand.css';
import '../styles/docs-accessibility.css';
import '../styles/documentation.css';
import '../styles/genux-input.css';
import '../styles/theme-builder.css';
import { logicalPath, structuredJson } from '../data/url-policy';
import { buildSeo } from '../data/seo';
import DocsShell from '../components/shell/DocsShell.astro';
import GenUXIcon from '../react/GenUXIcon';
import { genuxPageHref, shellPageSource } from '../data/foundation-navigation';
import { repositoryUrl } from '../data/repository';
import '../styles/focus-01.css';
import '../styles/adaptive-components.scss';
interface Props {
  title: string;
  description: string;
  slug?: string;
  noindex?: boolean;
  sourcePath?: string;
}
const {
  title,
  description,
  slug = '',
  noindex = false,
  sourcePath = shellPageSource(Astro.routePattern),
} = Astro.props;
const seo = noindex
  ? undefined
  : buildSeo({
      path: logicalPath(Astro.url.pathname, import.meta.env.BASE_URL),
      title,
      description,
    });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-i18n-content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content={seo!.robots} />
        <link rel="canonical" href={seo!.canonical} />
        {Object.entries(seo!.openGraph).map(([property, content]) => (
          <meta property={property} content={content} />
        ))}
        {Object.entries(seo!.twitter).map(([name, content]) => (
          <meta name={name} content={content} />
        ))}
        <script
          type="application/ld+json"
          data-seo-graph
          is:inline
          set:html={structuredJson(seo!.graph)}
        />
      </>
    )}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:inline set:html={themeStyleText} />
    <style is:inline data-docs-brand-tokens set:html={docsBrandStyleText} />
    <style is:inline data-docs-typography set:html={docsTypographyStyleText} />
    <style is:inline data-docs-accessibility set:html={docsAccessibilityStyleText} />
    <style is:inline data-selection-sizes set:html={selectionSizeStyleText} />
    <script is:inline data-theme-bootstrap>
      (() => {
        let mode;
        try {
          const key = 'genux-theme';
          mode = localStorage.getItem(key);
          // Previous namespace identifier as character codes, read only to migrate a saved theme
          // before first paint; mirrors readMigratedItem in src/storage-migration.ts.
          const formerNamespaceCodes = [97, 116, 108, 97, 115];
          const legacy = String.fromCharCode(...formerNamespaceCodes) + '-theme';
          if (mode === null && key !== legacy) {
            mode = localStorage.getItem(legacy);
            if (mode !== null) {
              localStorage.setItem(key, mode);
              if (localStorage.getItem(key) === mode) localStorage.removeItem(legacy);
            }
          }
        } catch {}
        if (mode !== 'light' && mode !== 'dark')
          mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = mode;
        document.documentElement.style.colorScheme = mode;
      })();
    </script>
    <title data-i18n={title + ' · GenUX'}>{title} · GenUX</title>
    <slot name="head" />
  </head>
  <body data-genux-surface="docs">
    <a class="skip-link" href="#content">
      <span data-i18n="Skip to content">Skip to content</span>
    </a>
    <DocsShell slug={slug} title={title} sourcePath={sourcePath}>
      <Fragment slot="header">
        <header class="docs-header">
          <button
            type="button"
            class="docs-menu-toggle"
            data-docs-menu-toggle
            aria-controls="docs-navigation-drawer"
            aria-expanded="false"
          >
            <span data-i18n="Menu">Menu</span>
          </button>
          <a class="wordmark" href="/" aria-label="GenUX home" data-i18n-aria-label="GenUX home">
            Gen<span>UX</span>
          </a>
          <button
            type="button"
            class="docs-search-trigger"
            data-docs-search
            aria-keyshortcuts="Meta+K Control+K"
            aria-label="Search components"
            data-i18n-aria-label="Search components"
          >
            <span data-i18n="Search">Search</span>
            <kbd aria-hidden="true">⌘/Ctrl K</kbd>
          </button>

          <div
            class="locale-controls"
            role="group"
            aria-label="Language"
            data-i18n-aria-label="Language"
          >
            <button
              type="button"
              class="locale-option"
              data-locale-button="en"
              aria-pressed="true"
              aria-label="EN · English"
              data-i18n-aria-label="EN · English"
            >
              EN
            </button>
            <button
              type="button"
              class="locale-option"
              data-locale-button="tr"
              aria-pressed="false"
              aria-label="TR · Turkish"
              data-i18n-aria-label="TR · Turkish"
            >
              TR
            </button>
          </div>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            role="switch"
            aria-label="Dark theme"
            data-i18n-aria-label="Dark theme"
            aria-checked="false"
          >
            <span class="theme-toggle-thumb genux-motion-layer" aria-hidden="true"></span>
            <span class="theme-toggle-icon" aria-hidden="true">
              <GenUXIcon name="sun" />
            </span>
            <span class="theme-toggle-icon" aria-hidden="true">
              <GenUXIcon name="moon" />
            </span>
          </button>
          <script is:inline data-theme-control-bootstrap>
            document
              .querySelector('[data-theme-toggle]')
              ?.setAttribute(
                'aria-checked',
                String(document.documentElement.dataset.theme === 'dark'),
              );
          </script>
          <nav class="header-primary" aria-label="Primary" data-i18n-aria-label="Primary">
            <a href="/components/">
              <span data-i18n="Components">Components</span>
            </a>
            <a href={genuxPageHref(import.meta.env.BASE_URL)}>GenUX</a>
            <a href="/theme-builder/">
              <span data-i18n="Theme Builder">Theme Builder</span>
            </a>
            <a href={repositoryUrl}>GitHub</a>
          </nav>
          <a class="header-link" href="/getting-started/">
            <span data-i18n="Getting started">Getting started</span>
          </a>
        </header>
      </Fragment>
      <slot />
    </DocsShell>
    <script>
      import { installDocsController } from './docs-controller';
      import { installDocsPage } from '../components/docs-page';
      import { installSectionNavigation } from '../components/shell/section-navigation';

      installDocsController(document);
      installDocsPage(document);
      installSectionNavigation(document);
    </script>
  </body>
</html>
