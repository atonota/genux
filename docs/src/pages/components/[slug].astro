---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeExample from '../../components/CodeExample.astro';
import ApiReference from '../../components/ApiReference.astro';
import DocumentationNav from '../../components/DocumentationNav.astro';
import DocsInstall from '../../components/DocsInstall.astro';
import DocsPageTools from '../../components/DocsPageTools.astro';
import ContentsRail from '../../components/shell/ContentsRail.astro';
import ShellFooter from '../../components/shell/ShellFooter.astro';
import PageNavigation from '../../components/shell/PageNavigation.astro';
import PageBreadcrumb from '../../components/shell/PageBreadcrumb.astro';
import { components } from '../../data/catalog';
import { previewProfiles } from '../../preview/profiles';
import { routeStylesheets } from '../../data/component-routes';
import {
  astroExample as exampleSource,
  catalogNeighbors,
  componentSectionItems as sectionItems,
  componentSources,
  componentTabGroups as tabGroups,
  resourceGroups as componentResourceGroups,
} from '../../data/component-page';
import { WebButtonDemo as ButtonDemo } from '../../react/ButtonDemo';
import { WebInputDemo as InputDemo } from '../../react/InputDemo';
import { WebSelectDemo as SelectDemo } from '../../react/SelectDemo';
import PillDemo from '../../react/PillDemo';
import CardDemo from '../../react/CardDemo';
import SplitterDemo from '../../react/SplitterDemo';
import BreadcrumbDemo from '../../react/BreadcrumbDemo';
import PaginationDemo from '../../react/PaginationDemo';
import StepsDemo from '../../react/StepsDemo';
import AutoCompleteDemo from '../../react/AutoCompleteDemo';
import CascaderDemo from '../../react/CascaderDemo';
import DropdownDemo from '../../react/DropdownDemo';
import { WebCheckboxDemo as CheckboxDemo } from '../../react/CheckboxDemo';
import { WebRadioDemo as RadioDemo } from '../../react/RadioDemo';
import { WebSwitchDemo as SwitchDemo } from '../../react/SwitchDemo';
import SliderDemo from '../../react/SliderDemo';
import AccordionDemo from '../../react/AccordionDemo';
import FormDemo from '../../react/FormDemo';
import DrawerDemo from '../../react/DrawerDemo';
import EmptyStateDemo from '../../react/EmptyStateDemo';
import AvatarDemo from '../../react/AvatarDemo';
import {
  ToastDemo,
  AlertDemo,
  NotificationDemo,
  ModalDemo,
  PopconfirmDemo,
} from '../../react/FeedbackDemo';
import DateTimeDemo from '../../react/DateTimeDemo';
import CollectionDemo, { DataTableDemo } from '../../react/workspace/CollectionDemo';
import RecordDetailsDemo from '../../react/workspace/RecordDetailsDemo';
import RecordFormsDemo from '../../react/workspace/RecordFormsDemo';
import ConnectedWorkspace from '../../react/workspace/kit/ConnectedWorkspace';
import MediaDemo from '../../react/MediaDemo';
import ContentPatternsDemo from '../../react/ContentPatternsDemo';
import CarouselDemo from '../../react/CarouselDemo';
import UploadDemo from '../../react/UploadDemo';
import RichMenuDemo from '../../react/RichMenuDemo';
import ChartDemo from '../../react/ChartDemo';
import ListyDemo from '../../react/ListyDemo';
import BadgeDemo from '../../react/BadgeDemo';
import FabDemo from '../../react/FabDemo';
import { extractDemoStyles } from '../../ssr/styles';
import { sourceHref } from '../../published-sources';
import workspaceStyles from '../../styles/workspace.css?url';
import collectionStyles from '../../styles/workspace-collections.css?url';
import detailStyles from '../../styles/workspace-details.css?url';
import formStyles from '../../styles/workspace-forms.css?url';
import kitStyles from '../../styles/workspace-kit.css?url';
import connectedStyles from '../../styles/workspace-connected.css?url';
import kitCollectionStyles from '../../styles/kit-collections.css?url';
import kitRecordStyles from '../../styles/kit-records.css?url';
import sliderStyles from '../../styles/slider.css?url';
import buttonCatalogStyles from '../../styles/button-catalog.css?url';
import pillCatalogStyles from '../../styles/pill-catalog.css?url';
import cardCatalogStyles from '../../styles/card-catalog.css?url';
import genuxCardStyles from '../../styles/genux-card.css?url';
import splitterStyles from '../../styles/genux-splitter.css?url';
import splitterCatalogStyles from '../../styles/splitter-catalog.css?url';
import breadcrumbStyles from '../../styles/genux-breadcrumb.css?url';
import breadcrumbCatalogStyles from '../../styles/breadcrumb-catalog.css?url';
import paginationStyles from '../../styles/genux-pagination.css?url';
import paginationCatalogStyles from '../../styles/pagination-catalog.css?url';
import stepsStyles from '../../styles/genux-steps.css?url';
import stepsCatalogStyles from '../../styles/steps-catalog.css?url';
import autoCompleteStyles from '../../styles/genux-autocomplete.css?url';
import autoCompleteCatalogStyles from '../../styles/autocomplete-catalog.css?url';
import cascaderStyles from '../../styles/genux-cascader.css?url';
import cascaderCatalogStyles from '../../styles/cascader-catalog.css?url';
import dropdownStyles from '../../styles/genux-dropdown.css?url';
import dropdownCatalogStyles from '../../styles/dropdown-catalog.css?url';
import dataEntryCatalogStyles from '../../styles/data-entry-catalog.css?url';
import feedbackStyles from '../../styles/genux-feedback.css?url';
import dateTimeStyles from '../../styles/genux-date-time.css?url';
import selectionVariantStyles from '../../styles/genux-selection-variants.css?url';
import drawerExtensionStyles from '../../styles/genux-drawer-extensions.css?url';
import kitFormFixes from '../../styles/kit-forms-fixes.css?url';
import avatarStyles from '../../styles/genux-avatar.css?url';
import kitIdentityStyles from '../../styles/kit-identity.css?url';
import mediaStyles from '../../styles/genux-media.css?url';
import screenshotStyles from '../../styles/genux-screenshot.css?url';
import contentPatternStyles from '../../styles/genux-content-patterns.css?url';
import carouselStyles from '../../styles/genux-carousel.css?url';
import uploadStyles from '../../styles/genux-upload.css?url';
import richMenuStyles from '../../styles/genux-rich-menu.css?url';
import chartStyles from '../../styles/genux-chart.css?url';
import listyStyles from '../../styles/genux-listy.css?url';
import badgeStyles from '../../styles/genux-badge.css?url';
import fabStyles from '../../styles/genux-fab.css?url';
import previewDocumentStyles from '../../styles/preview-document.css?url';
import previewWorkbenchStyles from '../../styles/preview-workbench.css?url';
export function getStaticPaths() {
  return components.map(component => ({ params: { slug: component.slug }, props: { component } }));
}
const { component } = Astro.props;
const demos = {
  button: ButtonDemo,
  input: InputDemo,
  select: SelectDemo,
  pill: PillDemo,
  card: CardDemo,
  splitter: SplitterDemo,
  breadcrumb: BreadcrumbDemo,
  pagination: PaginationDemo,
  steps: StepsDemo,
  autocomplete: AutoCompleteDemo,
  cascader: CascaderDemo,
  dropdown: DropdownDemo,
  checkbox: CheckboxDemo,
  radio: RadioDemo,
  switch: SwitchDemo,
  slider: SliderDemo,
  accordion: AccordionDemo,
  form: FormDemo,
  drawer: DrawerDemo,
  'empty-state': EmptyStateDemo,
  avatar: AvatarDemo,
  toast: ToastDemo,
  alert: AlertDemo,
  notification: NotificationDemo,
  modal: ModalDemo,
  popconfirm: PopconfirmDemo,
  'date-time': DateTimeDemo,
  'data-table': DataTableDemo,
  'collection-views': CollectionDemo,
  'record-details': RecordDetailsDemo,
  'record-forms': RecordFormsDemo,
  'record-workspace': ConnectedWorkspace,
  media: MediaDemo,
  'content-patterns': ContentPatternsDemo,
  carousel: CarouselDemo,
  upload: UploadDemo,
  'rich-menu': RichMenuDemo,
  chart: ChartDemo,
  listy: ListyDemo,
  badge: BadgeDemo,
  fab: FabDemo,
};
// Hashed URLs of the route stylesheets; the component route contract decides which a route loads
// and in which cascade order. The head links and the generated Astro example read the same list.
const stylesheetUrls: Record<string, string> = {
  'preview-document.css': previewDocumentStyles,
  'preview-workbench.css': previewWorkbenchStyles,
  'slider.css': sliderStyles,
  'button-catalog.css': buttonCatalogStyles,
  'pill-catalog.css': pillCatalogStyles,
  'genux-card.css': genuxCardStyles,
  'card-catalog.css': cardCatalogStyles,
  'genux-splitter.css': splitterStyles,
  'splitter-catalog.css': splitterCatalogStyles,
  'genux-breadcrumb.css': breadcrumbStyles,
  'breadcrumb-catalog.css': breadcrumbCatalogStyles,
  'genux-pagination.css': paginationStyles,
  'pagination-catalog.css': paginationCatalogStyles,
  'genux-steps.css': stepsStyles,
  'steps-catalog.css': stepsCatalogStyles,
  'genux-autocomplete.css': autoCompleteStyles,
  'autocomplete-catalog.css': autoCompleteCatalogStyles,
  'genux-cascader.css': cascaderStyles,
  'genux-listy.css': listyStyles,
  'cascader-catalog.css': cascaderCatalogStyles,
  'genux-dropdown.css': dropdownStyles,
  'dropdown-catalog.css': dropdownCatalogStyles,
  'data-entry-catalog.css': dataEntryCatalogStyles,
  'genux-selection-variants.css': selectionVariantStyles,
  'genux-drawer-extensions.css': drawerExtensionStyles,
  'genux-avatar.css': avatarStyles,
  'genux-feedback.css': feedbackStyles,
  'genux-date-time.css': dateTimeStyles,
  'workspace.css': workspaceStyles,
  'workspace-collections.css': collectionStyles,
  'workspace-details.css': detailStyles,
  'workspace-forms.css': formStyles,
  'workspace-kit.css': kitStyles,
  'kit-forms-fixes.css': kitFormFixes,
  'workspace-connected.css': connectedStyles,
  'kit-collections.css': kitCollectionStyles,
  'kit-records.css': kitRecordStyles,
  'kit-identity.css': kitIdentityStyles,
  'genux-media.css': mediaStyles,
  'genux-screenshot.css': screenshotStyles,
  'genux-content-patterns.css': contentPatternStyles,
  'genux-carousel.css': carouselStyles,
  'genux-upload.css': uploadStyles,
  'genux-rich-menu.css': richMenuStyles,
  'genux-chart.css': chartStyles,
  'genux-badge.css': badgeStyles,
  'genux-fab.css': fabStyles,
};
const routeSheets = routeStylesheets(component.slug).map(file => {
  const href = stylesheetUrls[file];
  if (!href) throw new Error(`Component route stylesheet ${file} has no import.`);
  return { file, href };
});
const ssrStyles = extractDemoStyles(demos[component.slug as keyof typeof demos], {
  documentation: true,
});

const sources = componentSources[component.slug];
const astroExample = exampleSource(
  component,
  routeSheets.map(sheet => sheet.file),
);
const resourceGroups = componentResourceGroups(component.slug);
const { previous: previousComponent, next: nextComponent } = catalogNeighbors(component.slug);
---

<DocsLayout title={component.title} description={component.summary} slug={component.slug}>
  <Fragment slot="head">
    <Fragment set:html={ssrStyles} />
    {routeSheets.map(sheet => (
      <link rel="stylesheet" href={sheet.href} />
    ))}
  </Fragment>
  <div class="page-grid">
    <article class="component-detail" data-component-detail>
      <PageBreadcrumb
        items={[{ label: 'Components', href: '/components/' }, { label: component.category }]}
        current={component.title}
      />
      <h1 data-i18n={component.title}>{component.title}</h1>
      <p class="lead" data-i18n={component.summary}>
        {component.summary}
      </p>
      <div class="component-meta">
        <span>Ant Design · {component.antdComponent}</span>
        <a href={component.sourceUrl}>
          <span data-i18n="Official API reference">Official API reference</span>
        </a>
      </div>
      <DocumentationNav items={sectionItems} />
      <div
        class="doc-tabs"
        role="tablist"
        aria-label="Documentation views"
        data-i18n-aria-label="Documentation views"
        data-doc-tabs
        hidden
      >
        {tabGroups.map(tab => (
          <button
            type="button"
            class="doc-choice"
            role="tab"
            id={`doc-tab-${component.slug}-${tab.id}`}
            data-doc-tab={tab.id}
            aria-selected="false"
            aria-controls={tab.sections.join(' ')}
            tabindex="-1"
          >
            <span data-i18n={tab.label}>{tab.label}</span>
          </button>
        ))}
      </div>
      <div class="component-showcase" data-component-showcase>
        <section
          id="usage"
          class="doc-section"
          data-doc-section="usage"
          data-doc-panel="overview"
          aria-labelledby="usage-title"
        >
          <h2 id="usage-title">
            <span data-i18n="When to use">When to use</span>
          </h2>
          <ul>
            {component.whenToUse.map(item => (
              <li data-i18n={item}>{item}</li>
            ))}
          </ul>
        </section>
        <section
          id="examples"
          class="doc-section"
          data-doc-section="examples"
          data-doc-panel="examples"
          aria-labelledby="examples-title"
        >
          <h2 id="examples-title">
            <span data-i18n="Live examples">Live examples</span>
          </h2>
          <div class="live-preview" data-doc-demo>
            {component.slug === 'button' && <ButtonDemo documentation client:load />}
            {component.slug === 'input' && <InputDemo documentation client:load />}
            {component.slug === 'select' && <SelectDemo documentation client:load />}
            {component.slug === 'pill' && <PillDemo documentation client:load />}
            {component.slug === 'card' && <CardDemo documentation client:load />}
            {component.slug === 'splitter' && <SplitterDemo documentation client:load />}
            {component.slug === 'breadcrumb' && <BreadcrumbDemo documentation client:load />}
            {component.slug === 'pagination' && <PaginationDemo documentation client:load />}
            {component.slug === 'steps' && <StepsDemo documentation client:load />}
            {component.slug === 'autocomplete' && <AutoCompleteDemo documentation client:load />}
            {component.slug === 'cascader' && <CascaderDemo documentation client:load />}
            {component.slug === 'dropdown' && <DropdownDemo documentation client:load />}
            {component.slug === 'checkbox' && <CheckboxDemo documentation client:load />}
            {component.slug === 'radio' && <RadioDemo documentation client:load />}
            {component.slug === 'switch' && <SwitchDemo documentation client:load />}
            {component.slug === 'slider' && <SliderDemo documentation client:load />}
            {component.slug === 'accordion' && <AccordionDemo documentation client:load />}
            {component.slug === 'form' && <FormDemo documentation client:load />}
            {component.slug === 'drawer' && <DrawerDemo documentation client:load />}
            {component.slug === 'empty-state' && <EmptyStateDemo documentation client:load />}
            {component.slug === 'avatar' && <AvatarDemo documentation client:load />}
            {component.slug === 'toast' && <ToastDemo documentation client:load />}
            {component.slug === 'alert' && <AlertDemo documentation client:load />}
            {component.slug === 'notification' && <NotificationDemo documentation client:load />}
            {component.slug === 'modal' && <ModalDemo documentation client:load />}
            {component.slug === 'popconfirm' && <PopconfirmDemo documentation client:load />}
            {component.slug === 'date-time' && <DateTimeDemo documentation client:load />}
            {component.slug === 'data-table' && <DataTableDemo documentation client:load />}
            {component.slug === 'collection-views' && <CollectionDemo documentation client:load />}
            {component.slug === 'record-details' && <RecordDetailsDemo documentation client:load />}
            {component.slug === 'record-forms' && <RecordFormsDemo documentation client:load />}
            {component.slug === 'record-workspace' && (
              <ConnectedWorkspace documentation client:load />
            )}
            {component.slug === 'media' && <MediaDemo documentation client:load />}
            {component.slug === 'content-patterns' && (
              <ContentPatternsDemo documentation client:load />
            )}
            {component.slug === 'carousel' && <CarouselDemo documentation client:load />}
            {component.slug === 'upload' && <UploadDemo documentation client:load />}
            {component.slug === 'rich-menu' && <RichMenuDemo documentation client:load />}
            {component.slug === 'chart' && <ChartDemo documentation client:load />}
            {component.slug === 'listy' && <ListyDemo documentation client:load />}
            {component.slug === 'badge' && <BadgeDemo documentation client:load />}
            {component.slug === 'fab' && <FabDemo documentation client:load />}
          </div>
          <noscript>
            <p>
              <span data-i18n="Example interactions require JavaScript. API documentation and usage code remain readable below.">
                Example interactions require JavaScript. API documentation and usage code remain
                readable below.
              </span>
            </p>
          </noscript>
        </section>
        <section
          id="code"
          class="doc-section"
          data-doc-section="code"
          data-doc-panel="integration"
          aria-labelledby="code-title"
        >
          <h2 id="code-title">
            <span data-i18n="Usage code">Usage code</span>
          </h2>
          <DocsInstall />
          {component.examples.map(example => (
            <div class="example-code">
              <h3 data-i18n={example.title}>{example.title}</h3>
              <p data-i18n={example.description}>{example.description}</p>
              <CodeExample code={example.code} title={example.title} />
            </div>
          ))}
        </section>
        <section
          id="astro"
          class="doc-section"
          data-doc-section="astro"
          data-doc-panel="integration"
          aria-labelledby="astro-title"
        >
          <h2 id="astro-title">
            <span data-i18n="Astro integration">Astro integration</span>
          </h2>
          <p class="section-intro">
            <span data-i18n="Astro renders this page as static HTML. The live example is one trusted React island: Astro passes serializable props, while React owns state, events and focus inside the island.">
              Astro renders this page as static HTML. The live example is one trusted React island:
              Astro passes serializable props, while React owns state, events and focus inside the
              island.
            </span>
          </p>
          {astroExample && (
            <CodeExample code={astroExample} title="Astro page with a React island" />
          )}
          <h3 data-i18n="Preview profiles">Preview profiles</h3>
          <p>
            <span data-i18n="Each live example also has one preview URL per profile:">
              Each live example also has one preview URL per profile:
            </span>
          </p>
          <ul>
            {previewProfiles.map(profile => (
              <li>
                <code>{`/preview/<id>/${profile}/`}</code>
              </li>
            ))}
          </ul>
          <p>
            <span data-i18n="The build server-renders every profile document ahead of time, so GitHub Pages serves static HTML. The browser hydrates only the delivery entry of that same profile.">
              The build server-renders every profile document ahead of time, so GitHub Pages serves
              static HTML. The browser hydrates only the delivery entry of that same profile.
            </span>
          </p>
          <p>
            <span data-i18n="The device selector in these docs chooses the profile manually. Request-time device detection for a product is not implemented.">
              The device selector in these docs chooses the profile manually. Request-time device
              detection for a product is not implemented.
            </span>
          </p>
          <p>
            <span data-i18n="All profiles reuse the same shared example logic. Only the selected profile entry is loaded, together with the shared modules it requires.">
              All profiles reuse the same shared example logic. Only the selected profile entry is
              loaded, together with the shared modules it requires.
            </span>
          </p>
          <p class="documentation-link">
            <a href="/getting-started/#astro-integration">
              <span data-i18n="Read the Astro integration guide">
                Read the Astro integration guide
              </span>
            </a>
          </p>
        </section>
        <section
          id="accessibility"
          class="doc-section"
          data-doc-section="accessibility"
          data-doc-panel="overview"
          aria-labelledby="accessibility-title"
        >
          <h2 id="accessibility-title">
            <span data-i18n="Accessibility">Accessibility</span>
          </h2>
          <ul>
            {component.accessibility.map(item => (
              <li data-i18n={item}>{item}</li>
            ))}
          </ul>
        </section>
        <section
          id="notes"
          class="doc-section"
          data-doc-section="notes"
          data-doc-panel="overview"
          aria-labelledby="notes-title"
        >
          <h2 id="notes-title">
            <span data-i18n="Implementation notes">Implementation notes</span>
          </h2>
          <ul>
            {component.notes.map(item => (
              <li data-i18n={item}>{item}</li>
            ))}
          </ul>
        </section>
      </div>
      <div class="component-reference" data-component-reference>
        <section
          id="api"
          class="doc-section"
          data-doc-section="api"
          data-doc-panel="api"
          aria-labelledby="api-title"
        >
          <h2 id="api-title">API</h2>
          <p class="section-intro">
            <span data-i18n="Commonly used properties. See the official component reference for the full contract.">
              Commonly used properties. See the official component reference for the full contract.
            </span>
          </p>
          <h3 data-i18n="GenUX usage API">GenUX usage API</h3>
          {component.apiDescription && (
            <p data-i18n={component.apiDescription}>{component.apiDescription}</p>
          )}
          <ApiReference rows={component.api} label={component.title + ' API table'} />
          <h3 data-i18n="Underlying Ant Design API">Underlying Ant Design API</h3>
          {component.nativeApi && (
            <>
              <p data-i18n="These library settings are used inside the example. They are separate from the GenUX component props above.">
                These library settings are used inside the example. They are separate from the GenUX
                component props above.
              </p>
              <ApiReference rows={component.nativeApi} label="Ant Design API reference" />
            </>
          )}
          <p class="documentation-link">
            <a data-doc-official-reference href={component.sourceUrl}>
              <span data-i18n="Official API reference">Official API reference</span>
            </a>
          </p>
        </section>
        <section
          id="resources"
          class="doc-section"
          data-doc-section="resources"
          data-doc-panel="integration"
          aria-labelledby="resources-title"
        >
          <h2 id="resources-title">
            <span data-i18n="Source and resources">Source and resources</span>
          </h2>
          <ul class="documentation-resources">
            {resourceGroups.map(group => (
              <li data-doc-resource={group.kind}>
                <span data-i18n={group.label}>{group.label}</span>
                {group.paths.map(path => {
                  const href = sourceHref(path);
                  return href ? (
                    <a href={href} data-doc-source-link>
                      <code data-doc-source>{path}</code>
                    </a>
                  ) : (
                    <code data-doc-source>{path}</code>
                  );
                })}
              </li>
            ))}
          </ul>
          {sources?.capabilities?.length ? (
            <p data-doc-capability-status>
              <span data-i18n="Registered GenUX capabilities from this component family:">
                Registered GenUX capabilities from this component family:
              </span>{' '}
              {sources.capabilities.map(name => (
                <code>{name}</code>
              ))}
            </p>
          ) : (
            <p data-doc-capability-status>
              <span data-i18n="No GenUX capability is registered for this component yet. A catalog entry or React export alone is not a GenUX capability.">
                No GenUX capability is registered for this component yet. A catalog entry or React
                export alone is not a GenUX capability.
              </span>
            </p>
          )}
        </section>
      </div>
      <DocsPageTools
        placement="article"
        sourcePath="docs/src/pages/components/[slug].astro"
        pageTitle={component.title}
      />
      <PageNavigation previous={previousComponent} next={nextComponent} />
      <ShellFooter />
    </article>
    <ContentsRail
      items={sectionItems}
      sourcePath="docs/src/pages/components/[slug].astro"
      pageTitle={component.title}
    />
  </div>
  <script>
    import { installDocsPage } from '../../components/docs-page';

    installDocsPage(document);
  </script>
</DocsLayout>
